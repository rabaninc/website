# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code permissions (machine-specific; launch.json stays tracked)
.claude/settings.local.json

# scratch copies of superseded files, kept locally until the loop has run once.
# Must stay untracked: `next build` type-checks it and it does not compile.
/_to_delete/

# Filme des Pitch-Decks (werkzeuge/deck-film)
/werkzeuge/deck-film/bilder
